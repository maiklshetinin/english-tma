// Firebase → Firestore → Rules → вставить и опубликовать.
// Сайт НЕ обращается к Firestore напрямую: всё идёт через сервер (Render), а он работает через Admin SDK, которому правила не мешают.
// Поэтому клиентам закрыто всё.
rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    match /{document=**} { allow read, write: if false; }
  }
}
